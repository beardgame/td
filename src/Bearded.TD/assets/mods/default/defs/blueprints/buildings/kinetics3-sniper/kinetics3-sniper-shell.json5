{
    id: "kinetics3-sniper-shell",
    components: [
        { id: "tags", parameters: { tags: [ "bullet", "projectile" ] } },
        {
            id: "damageOnHit",
            parameters: {
            }
        },
        { id : "elasticCollision", keys: [ "remove-on-overdrive" ], parameters : { normal : 1, tangent : 1 } },
        { id: "deleteOnHit", keys: [ "remove-on-overdrive" ], parameters: { excludeObjects: true } },
        {
            id: "sprite",
            parameters: {
                sprite: "default.shells.bullet",
                shader: "building",
                drawGroup: "building",
                size: 0.08,
                rotationOffset: -90,
            }
        },
        {
            id: "spawnObjectOnHit",
            keys: [ "remove-on-overdrive" ],
            parameters: {
                object: "sparkExplosion",
                onHitLevel: true,
                onHitEnemy: false
            }
        },
        { id: "child", parameters: { object: "kinetics3-sniper-shell-smoke-trail", surviveParent: true } },
    ]
}
